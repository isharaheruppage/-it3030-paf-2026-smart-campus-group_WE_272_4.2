      "request": {
        "method": "DELETE",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{adminUsername}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{adminPassword}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/resources/{{resourceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "resources",
            "{{resourceId}}"
          ]
        }
